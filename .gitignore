# ============================================================
# .gitignore — Automotive Sales Analysis
# Zero-Data-Leakage Policy: ALL business data stays local.
# ============================================================

# ── Data Files (CRITICAL — never commit) ─────────────────────
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.arrow
*.hdf5
*.h5
*.pickle
*.pkl
*.json
!package.json
*.db
*.sqlite
*.duckdb
data/
exports/

# ── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so
*.whl

# ── Virtual Environments ────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_metadata/

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS Artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs & Reports (generated outputs) ──────────────────────
*.log
logs/
reports/*.html
reports/*.pdf
